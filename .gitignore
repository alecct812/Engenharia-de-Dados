# ---------------------------------------------------------------- credenciais
# NUNCA versionar. O historico do git e permanente: um segredo commitado uma vez
# continua acessivel mesmo depois de apagado num commit seguinte.
cred.txt
credenciais.txt
credentials
.env
.env.*
*.pem
*.key
*.pfx
.aws/

